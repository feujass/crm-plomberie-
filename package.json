{
  "name": "plombicrm",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){if(e.code!=='ENOENT')throw e;}};['.next','node_modules/.cache','.turbo'].forEach(rm);\"",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3001",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start",
    "start:debug-session": "SESSION_DEBUG_LOG=1 next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "legal:registre-pdf": "npx md-to-pdf docs/registre-traitements-flowo.md",
    "test:conformite": "cd backend && python3 -m unittest discover -s tests -p 'test_conformite.py' -v"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-visually-hidden": "^1.1.3",
    "@react-pdf/renderer": "^4.3.0",
    "@remixicon/react": "^4.6.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "15.5.15",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.399.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "resend": "^4.1.2",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.15",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
