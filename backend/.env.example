MONGO_URL=mongodb://localhost:27017
DB_NAME=plombicrm
# En production : au moins 32 caractères. Ne jamais utiliser "change_me" en prod.
JWT_SECRET=change_me_use_32_chars_minimum_in_production

# CORS : par défaut localhost uniquement (jamais *). En production, listez les origines HTTPS.
# CORS_ALLOW_ORIGINS=https://app.exemple.fr

# Compte admin seedé au démarrage — désactivé par défaut. Activer uniquement en dev local :
# ENABLE_ADMIN_SEED=1
# ADMIN_EMAIL=admin@plombicrm.com
# ADMIN_PASSWORD=mot_de_passe_fort_10_caracteres_minimum

# Les routes /api/ai/* (FastAPI) renvoient 501 — Zeus IA utilise Claude côté Next (ANTHROPIC_API_KEY dans .env.local).

# --- Conformité facturation France (PDP / e-reporting) ---
# En développement : simulation sans appel réel (transmissions en statut simulated_ok).
PDP_SIMULATE=true

# Secret interne Next.js → backend (reset password, Stripe sync). Distinct de CRON_SECRET.
# INTERNAL_API_SECRET=

# Cron : Authorization: Bearer … uniquement (pas de ?secret= en query).
# CRON_SECRET=
