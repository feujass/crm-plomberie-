MONGO_URL=mongodb://localhost:27017
DB_NAME=plombicrm
# En production : au moins 32 caractères (PyJWT / sécurité). Éviter "change_me" en prod.
JWT_SECRET=change_me

# CORS : par défaut le serveur accepte toutes les origines ("*"). En production, listez les origines
# autorisées (séparées par des virgules), p.ex. l’URL du site Next en HTTPS.
# CORS_ALLOW_ORIGINS=https://app.exemple.fr,http://localhost:3000

# (Optionnel) Compte admin seedé au démarrage
ADMIN_EMAIL=admin@plombicrm.com
ADMIN_PASSWORD=admin123

# Les routes /api/ai/* (FastAPI) renvoient 501 — l’assistant Zeus utilise OpenAI côté Next (OPENAI_API_KEY dans .env.local).

# --- Conformité facturation France (PDP / e-reporting) ---
# En développement : simulation sans appel réel (transmissions en statut simulated_ok).
PDP_SIMULATE=true
# Intégration PDP réelle (quand PDP_SIMULATE=false) :
# PDP_API_URL=https://votre-pdp.example/api
# PDP_API_KEY=

# Signature électronique avancée (devis) — brancher Yousign / DocuSign / etc.
# ESIGN_PROVIDER=yousign
# ESIGN_API_KEY=
# ESIGN_WEBHOOK_SECRET=

# Même valeur que CRON_SECRET côté Next (relances devis/factures via /api/cron/*).
# CRON_SECRET=
