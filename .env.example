# Copier ce fichier vers .env.local (Next.js charge automatiquement .env.local).
# Ne commitez jamais .env.local.

# --- Backend FastAPI (source de vérité) ---
# URL du backend FastAPI (Emergent) — ex: http://localhost:8000
BACKEND_URL=http://localhost:8000

# URL publique du site (liens dans les e-mails, pages publiques devis/factures, Stripe return).
# Mot de passe oublié : doit correspondre à l’URL où tu ouvres l’app (ex. http://localhost:3001 si `next dev -p 3001`).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vidéo VSL landing (optionnel — défaut : /videos/flowo-vsl-web.mp4)
# NEXT_PUBLIC_VSL_VIDEO_URL=https://…

# E-mail affiché sur la page Compte → Équipe, footer marketing, mentions légales.
NEXT_PUBLIC_SUPPORT_EMAIL=flowo.contact@gmail.com

# --- Mentions légales (éditeur du site Flowo — LCEN) ---
# Micro-entreprise : raison sociale = nom de l'entrepreneur (ex. Jules Berliat), pas le nom du produit « Flowo »
# NEXT_PUBLIC_LEGAL_COMPANY_NAME=Jules Berliat
# NEXT_PUBLIC_LEGAL_LEGAL_FORM=Micro-entrepreneur (commerçant)
# NEXT_PUBLIC_LEGAL_SIRET=10013850200016
# NEXT_PUBLIC_LEGAL_ADDRESS=22B allée Claude Dumont, 69300 Caluire-et-Cuire
# NEXT_PUBLIC_LEGAL_DIRECTOR=Jules Berliat

# E-mails admin affiliation (séparés par virgule). Par défaut = NEXT_PUBLIC_SUPPORT_EMAIL
# E-mails admin affiliation (séparés par virgule). Reçoivent l'alerte à chaque nouvelle candidature.
# FLOWO_ADMIN_EMAILS=flowo.contact@gmail.com,jules.berliat@gmail.com

# Accès LAN / autre hostname (npm run dev:lan ou IP locale) — hôtes supplémentaires pour experimental.serverActions.allowedOrigins (évite E394 CSRF si Next compare l’Origin).
# Séparateurs : virgule ou espace. Exemple : NEXT_EXTRA_ALLOWED_ORIGINS=192.168.1.42,192.168.1.101
# NEXT_EXTRA_ALLOWED_ORIGINS=

# Chemin NDJSON absolu ou relatif au cwd (debug session 0f238e) ; par défaut : `debug-session-0f238e.ndjson` à la racine du repo (`next.config`).
# NEXT_DEBUG_SESSION_LOG=debug-session-0f238e.ndjson
#
# Avec `next start` (NODE_ENV=production), `CRM_NEXT_IS_DEV_TUNNEL` vaut 0 : activer l’écriture des logs session / acceptation des POST `/api/debug/session-log` :
# SESSION_DEBUG_LOG=1
#
# Ou : `npm run start:debug-session` (sans éditer .env.local).
#
# Ou (rebuild après changement — injecté dans le bundle client/public) pour activer sondes E394/session sur preview :
# NEXT_PUBLIC_CRM_DEBUG_UI=1
#
# Alternative sans .env : créer un fichier vide à la racine du repo (gitignored) :
#   touch .session-debug-enable

# Numéro WhatsApp Business du bot (chiffres seuls, sans +) — wa.me + message prérempli sur l’accueil
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=33612345678

# --- Backend FastAPI : variables (à mettre dans backend/.env) ---
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=plombicrm
# JWT_SECRET= (>= 32 caractères en production — voir backend/.env.example)
# CORS_ALLOW_ORIGINS= (optionnel, prod : origines autorisées, séparées par des virgules)
# ADMIN_EMAIL=admin@plombicrm.com
# ADMIN_PASSWORD=admin123
#
# PDP_SIMULATE, PDP_API_URL, PDP_API_KEY : voir backend/.env.example (conformité facturation FR).

# --- Claude (Zeus IA : chat, devis vocal/texte, import photo/PDF) ---
# Reconnaissance vocale : navigateur (Chrome, Edge, Safari) — pas de clé supplémentaire.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=4096

# --- Supabase (compte, auth callback, certaines intégrations) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (réservé serveur — requis pour e-mails Flowo personnalisés via Resend)
#
# Connexion Google (Supabase Dashboard → Authentication → Providers → Google) :
# 1. Créer un client OAuth dans Google Cloud Console (type « Application Web »).
# 2. URI de redirection autorisée côté Google : https://<project-ref>.supabase.co/auth/v1/callback
# 3. Coller Client ID + Secret dans Supabase → Google provider.
# 4. Supabase → Authentication → URL Configuration :
#    - Site URL : https://votre-domaine.com (ou http://localhost:3000 en local)
#    - Redirect URLs : http://localhost:3000/auth/callback , https://votre-domaine.com/auth/callback
# Sans Supabase configuré, le bouton « S'inscrire avec Google » n'apparaît pas (auth FastAPI classique).

# --- Resend (e-mails transactionnels) ---
# Remplace la valeur vide par ta vraie clé API (commence par re_…) depuis https://resend.com/api-keys
# Ne pas utiliser le placeholder re_xxxxxxxxx dans le code : uniquement ici ou dans .env.local
RESEND_API_KEY=
# Adresse d'EXPÉDITEUR vérifiée dans Resend (domaine ou onboarding@resend.dev en test).
# Les e-mails CLIENTS (destinataires) n'ont pas besoin d'être enregistrés dans Resend.
# En test avec onboarding@resend.dev, Resend n'envoie qu'aux adresses du compte Resend.
# En prod : vérifie ton domaine (ex. devis@mon-entreprise.fr) puis mets-le ici.
# Le nom affiché côté client = nom entreprise du profil artisan (pas « Flowo »).
RESEND_FROM="Flowo <onboarding@resend.dev>"

# --- Stripe (abonnement / webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret du webhook prod : https://flowo.agency/api/webhooks/stripe
# Legacy (plan Pro mensuel uniquement)
STRIPE_PRICE_PRO=
# Multi-plans (générés par scripts/setup-stripe-flowo.mjs)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_YEARLY=
STRIPE_PRICE_PME_MONTHLY=
STRIPE_PRICE_PME_YEARLY=

# Secret partagé Next.js → backend (webhooks Stripe, reset password interne). Distinct de CRON_SECRET.
INTERNAL_API_SECRET=

# --- Cron Vercel (/api/cron/*) : en-tête Authorization: Bearer … uniquement (pas de ?secret=) ---
CRON_SECRET=

# --- Twilio (SMS / WhatsApp — relances artisan + tests notifications) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+33XXXXXXXXX
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Sandbox : depuis votre mobile, envoyez « join <mot-clé> » au numéro sandbox Twilio.
# Template WhatsApp (Content API) — obligatoire en prod / hors fenêtre 24 h :
# 1. Twilio Console → Messaging → Content Template Builder
# 2. Créer un template texte avec une variable {{1}} (corps du message Zeus)
# 3. Approuver pour WhatsApp, puis copier le SID (commence par HX)
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel si Twilio l'exige pour les templates :
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe Connect (virements partenaires affiliation) ---
# Activer Connect dans le Dashboard Stripe (Express accounts).
# Les partenaires configurent leur IBAN depuis /partenaire/commissions.

# --- PostHog (statistiques d'usage — cookies analytiques, consentement requis) ---
# Créer un projet sur https://eu.posthog.com (région UE recommandée)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Meta Pixel (optionnel — chargé uniquement si consentement analytique)
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
