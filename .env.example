# Copier ce fichier vers .env.local (Next.js charge automatiquement .env.local).
# Ne commitez jamais .env.local.

# --- Backend FastAPI (source de vérité) ---
# URL du backend FastAPI (Emergent) — ex: http://localhost:8000
BACKEND_URL=http://localhost:8000

# URL publique du site (liens dans les e-mails, pages publiques devis/factures, Stripe return).
# Mot de passe oublié : doit correspondre à l’URL où tu ouvres l’app (ex. http://localhost:3001 si `next dev -p 3001`).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail affiché sur la page Compte → Équipe (mailto invitation / sièges).
# NEXT_PUBLIC_SUPPORT_EMAIL=bonjour@votredomaine.fr

# Accès LAN / autre hostname (npm run dev:lan ou IP locale) — hôtes supplémentaires pour experimental.serverActions.allowedOrigins (évite E394 CSRF si Next compare l’Origin).
# Séparateurs : virgule ou espace. Exemple : NEXT_EXTRA_ALLOWED_ORIGINS=192.168.1.42,192.168.1.101
# NEXT_EXTRA_ALLOWED_ORIGINS=

# Chemin NDJSON absolu ou relatif au cwd (debug session 0f238e) ; par défaut : `debug-session-0f238e.ndjson` à la racine du repo (`next.config`).
# NEXT_DEBUG_SESSION_LOG=debug-session-0f238e.ndjson
#
# Avec `next start` (NODE_ENV=production), `CRM_NEXT_IS_DEV_TUNNEL` vaut 0 : activer l’écriture des logs session / acceptation des POST `/api/debug/session-log` :
# SESSION_DEBUG_LOG=1
#
# Ou : `npm run start:debug-session` (sans éditer .env.local).
#
# Ou (rebuild après changement — injecté dans le bundle client/public) pour activer sondes E394/session sur preview :
# NEXT_PUBLIC_CRM_DEBUG_UI=1
#
# Alternative sans .env : créer un fichier vide à la racine du repo (gitignored) :
#   touch .session-debug-enable

# Numéro WhatsApp Business du bot (chiffres seuls, sans +) — wa.me + message prérempli sur l’accueil
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=33612345678

# --- Backend FastAPI : variables (à mettre dans backend/.env) ---
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=plombicrm
# JWT_SECRET= (>= 32 caractères en production — voir backend/.env.example)
# CORS_ALLOW_ORIGINS= (optionnel, prod : origines autorisées, séparées par des virgules)
# ADMIN_EMAIL=admin@plombicrm.com
# ADMIN_PASSWORD=admin123
#
# PDP_SIMULATE, PDP_API_URL, PDP_API_KEY : voir backend/.env.example (conformité facturation FR).

# --- Assistant web /api/assistant/flowo-chat : OpenAI (défaut) ou Anthropic (Claude) ---
# Choisir le fournisseur pour le chat web uniquement (autres routes = OpenAI).
# Absent ou "openai" : OPENAI requis. "claude" : ANTHROPIC_API_KEY requis.
# FLOWO_LLM=openai
# FLOWO_LLM=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=4096

# --- OpenAI (défaut flowo-chat si FLOWO_LLM=openai ; génération devis, vision, transcription ; mobile /api/assistant/chat) ---
# OBLIGATOIRE sur l’hébergement Next (Vercel, etc.) pour ces routes (sinon HTTP 500), sauf flowo-chat en mode claude.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Supabase (compte, auth callback, certaines intégrations) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (réservé serveur, opérations admin)

# --- Resend (e-mails transactionnels) ---
# Remplace la valeur vide par ta vraie clé API (commence par re_…) depuis https://resend.com/api-keys
# Ne pas utiliser le placeholder re_xxxxxxxxx dans le code : uniquement ici ou dans .env.local
RESEND_API_KEY=
RESEND_FROM="Flowo <onboarding@resend.dev>"

# --- Stripe (abonnement / webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy (plan Pro mensuel uniquement)
STRIPE_PRICE_PRO=
# Multi-plans (générés par scripts/setup-stripe-flowo.mjs)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_YEARLY=
STRIPE_PRICE_PME_MONTHLY=
STRIPE_PRICE_PME_YEARLY=

# Secret partagé Next.js → backend (webhooks Stripe). Peut réutiliser CRON_SECRET.
INTERNAL_API_SECRET=

# --- Cron Vercel (/api/cron/*) : même valeur que l’en-tête Authorization: Bearer … ---
CRON_SECRET=
