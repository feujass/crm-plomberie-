# Copier vers .env (à la racine du dossier mobile/).
# Expo injecte les variables préfixées par EXPO_PUBLIC_ dans l’app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL de base de l’app web Flowo (HTTPS en production).
# Le mobile appelle les routes /api/assistant/chat sur ce host : le serveur Next doit avoir OPENAI_API_KEY
# (voir .env.local à la racine du repo) pour que l’assistant réponde.
# En dev avec un appareil physique : souvent http://192.168.x.x:3000 (même Wi‑Fi que la machine qui lance Next).
# Build EAS : définir ces variables dans le profil de build (secrets) — voir APP_STORE_CHECKLIST.txt
EXPO_PUBLIC_SITE_URL=http://localhost:3000
