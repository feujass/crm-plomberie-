# Copier vers .env (à la racine du dossier mobile/).
# Expo injecte les variables préfixées par EXPO_PUBLIC_ dans l’app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL de base de l’app web Flowo (HTTPS en production).
# En dev avec un appareil physique : souvent http://192.168.x.x:3000 (même Wi‑Fi que la machine qui lance Next).
EXPO_PUBLIC_SITE_URL=http://localhost:3000
